# Copy to .env.production on the server. Never commit the real file.
ERPNEXT_IMAGE=frappe/erpnext:v16.36.0
CUSTOM_IMAGE=ghcr.io/mburu1/erpnext-business-suite
CUSTOM_TAG=replace-with-40-character-git-sha
SITE_NAME=erp.example.com
DB_ROOT_PASSWORD=replace-with-a-long-random-password
ADMIN_PASSWORD=replace-with-a-long-random-password
APP_PORT=8080
FRAPPE_SITE_NAME_HEADER=erp.example.com
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
# The deployment script accepts only immutable Git-SHA image tags.
